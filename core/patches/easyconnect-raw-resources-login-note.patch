+
+// loginNote extracts the human readable <Note> of a failed auth reply.
+func loginNote(reply string) string {
+	if i := strings.Index(reply, "<Note><![CDATA["); i >= 0 {
+		rest := reply[i+len("<Note><![CDATA["):]
+		if j := strings.Index(rest, "]]>"); j > 0 {
+			return strings.TrimSpace(rest[:j])
+		}
+	}
+	return reply
+}
