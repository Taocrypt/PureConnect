diff --git a/client/easyconnect/l3conn_close_test.go b/client/easyconnect/l3conn_close_test.go
new file mode 100644
index 0000000..9fdab06
--- /dev/null
+++ b/client/easyconnect/l3conn_close_test.go
@@ -0,0 +1,21 @@
+package easyconnect
+
+import "testing"
+
+// A failed re-handshake leaves nil connections; Close must not panic and
+// must be idempotent, and I/O afterwards must fail instead of crashing.
+func TestL3ConnCloseWithNilConns(t *testing.T) {
+	c := &L3Conn{}
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.Read(make([]byte, 10)); err == nil {
+		t.Fatal("read after close succeeded")
+	}
+	if _, err := c.Write([]byte{1}); err == nil {
+		t.Fatal("write after close succeeded")
+	}
+}
